# =============================================================
# .env.local - Local configuration for system-update-automation
# Copy this file to .env.local and fill in your values
# This file is in .gitignore and will NEVER be committed
# =============================================================

# =============================================================
# MQTT Configuration (Mosquitto broker)
# Leave empty to disable MQTT reporting
# =============================================================
MQTT_BROKER=""              # e.g. 10.20.30.33
MQTT_PORT="1883"            # default 1883
MQTT_TOPIC_PREFIX="homelab" # e.g. homelab/mac/status
MQTT_USERNAME=""            # leave empty if no auth
MQTT_PASSWORD=""            # leave empty if no auth

# =============================================================
# HTTP Status Server (alternative to MQTT)
# Leave empty to disable HTTP reporting
# =============================================================
STATUS_SERVER_URL=""        # e.g. http://10.20.80.50/api/status
STATUS_SERVER_TOKEN=""      # Bearer token for auth

# =============================================================
# Notification settings
# =============================================================
NOTIFY_SLACK_WEBHOOK=""     # Slack incoming webhook URL
NOTIFY_DISCORD_WEBHOOK=""   # Discord webhook URL
NOTIFY_NTFY_TOPIC=""        # ntfy.sh topic name
NOTIFY_PUSHOVER_TOKEN=""    # Pushover app token
NOTIFY_PUSHOVER_USER=""     # Pushover user key
NOTIFY_EMAIL=""             # Email address for notifications

# =============================================================
# Device identity
# Used to identify this machine in MQTT topics and reports
# Defaults to hostname if not set
# =============================================================
DEVICE_NAME=""              # e.g. macbook-pawel, windows-vm, nas
DEVICE_LOCATION=""          # e.g. home-office, rack
